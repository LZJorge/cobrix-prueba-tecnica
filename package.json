{
	"name": "cobrix-prueba-facturacion",
	"version": "1.0.0",
	"private": true,
	"description": "Prueba técnica: integrar Cobrix con la API de un administrador de facturas.",
	"type": "module",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"build:ui": "vite build",
		"dev:ui": "vite",
		"start": "vite build && tsx --disable-warning=ExperimentalWarning src/main.ts",
		"seed": "node --disable-warning=ExperimentalWarning src/billing-api/seed.ts",
		"test": "tsx --disable-warning=ExperimentalWarning --test --test-concurrency=1 --test \"test/**/*.test.ts\"",
		"typecheck": "tsc --noEmit"
	},
	"devDependencies": {
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "24.3.0",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.1.2",
		"tailwindcss": "^4.3.3",
		"tsx": "^4.23.15",
		"typescript": "5.9.2",
		"vite": "^8.3.4"
	},
	"dependencies": {
		"@nestjs/common": "^12.1.3",
		"@nestjs/core": "^12.1.3",
		"@nestjs/platform-express": "^12.1.3",
		"@nestjs/serve-static": "^12.0.0",
		"class-transformer": "^0.5.1",
		"class-validator": "^0.15.1",
		"iconoir-react": "^7.12.1",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"reflect-metadata": "^0.2.2",
		"rxjs": "^7.8.2"
	}
}
